<% content_for :title, "Nuevo miembro" %>

<div class="page-header">
  <%= link_to "← Ajustes", settings_path, class: "btn btn--ghost btn--sm" %>
  <h1 class="display">Nuevo miembro</h1>
</div>

<%= form_with model: @user, url: users_path, class: "card form-card" do |f| %>
  <% if @user.errors.any? %>
    <div class="toast toast--warning">
      <ul class="error-list">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :email, "Correo" %>
    <%= f.email_field :email, required: true, placeholder: "persona@ejemplo.com" %>
  </div>

  <div class="field">
    <%= f.label :role, "Rol" %>
    <%= f.select :role, [["Planificador", "planificador"], ["Cocinero", "cocinero"]], include_blank: "—" %>
    <span class="hint">El planificador llena la semana; el cocinero la ejecuta.</span>
  </div>

  <div class="form-actions">
    <%= f.submit "Agregar", class: "btn" %>
    <%= link_to "Cancelar", settings_path, class: "btn btn--ghost" %>
  </div>
<% end %>
