<% content_for :title, @list.week.label %>

<div class="shopping-list__header">
  <div>
    <h1 class="display">Lista de compras</h1>
    <p class="caption shopping-list__meta"><%= @list.week.label %> · <%= @list.total_items %> renglones · <%= @list.purchased_count %> comprados</p>
  </div>
  <div class="flex-actions">
    <%= button_to "Regenerar", shopping_list_week_path(@list.week), method: :post, class: "btn btn--ghost btn--sm" %>
    <%= link_to "Ver semana", week_path(@list.week), class: "btn btn--ghost btn--sm" %>
  </div>
</div>

<% if @list.list_items.any? %>
  <% Ingredient::CATEGORIES.each do |category| %>
    <% items = @list.list_items.select { |i| i.ingredient.category == category } %>
    <% next if items.empty? %>
    <div class="list-group">
      <h2 class="list-group__title"><%= items.first.ingredient.category_label %></h2>
      <% items.each do |item| %>
        <%= render "shopping_lists/item", item: item, list: @list %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <%= render "shared/empty_state", icon: "🛒", message: "Esta semana no tiene platillos asignados. Llena la semana primero.", cta: link_to("Ir al planificador", week_path(@list.week), class: "btn") %>
<% end %>
