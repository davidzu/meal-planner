<% content_for :title, @recipe.persisted? ? "Editar receta" : "Nueva receta" %>

<div class="page-header">
  <%= link_to "← Recetario", recipes_path, class: "btn btn--ghost btn--sm" %>
  <h1 class="display"><%= @recipe.persisted? ? "Editar receta" : "Nueva receta" %></h1>
</div>

<%= form_with model: @recipe, class: "card form-card" do |f| %>
  <% if params[:return_week_id].present? %>
    <%= hidden_field_tag :return_week_id, params[:return_week_id] %>
    <%= hidden_field_tag :return_day_id, params[:return_day_id] %>
    <%= hidden_field_tag :return_meal_type, params[:return_meal_type] %>
  <% end %>

  <% if @recipe.errors.any? %>
    <div class="toast toast--warning">
      <ul class="error-list">
        <% @recipe.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, "Nombre" %>
    <%= f.text_field :name, required: true, placeholder: "Ej. Birria de res" %>
  </div>

  <div class="field">
    <%= f.label :description, "Descripción" %>
    <%= f.text_area :description, rows: 2, placeholder: "Resumen corto para la tarjeta" %>
  </div>

  <div class="field">
    <%= f.label :instructions, "Instrucciones" %>
    <%= f.text_area :instructions, rows: 8, placeholder: "Pasos de preparación" %>
  </div>

  <div class="form-grid-3">
    <div class="field">
      <%= f.label :prep_time_min, "Tiempo (min)" %>
      <%= f.number_field :prep_time_min, min: 1 %>
    </div>
    <div class="field">
      <%= f.label :base_servings, "Rinde (porciones)" %>
      <%= f.number_field :base_servings, min: 1, required: true %>
    </div>
    <div class="field">
      <%= f.label :calories_per_serving, "Kcal/porción" %>
      <%= f.number_field :calories_per_serving, min: 0 %>
    </div>
  </div>

  <div class="field">
    <%= f.label :tag_ids, "Etiquetas" %>
    <%= f.collection_select :tag_ids, Tag.order(:name), :id, :label, {}, { multiple: true, size: 4 } %>
    <span class="hint"><%= Tag.order(:name).map(&:label).join(" · ") %></span>
  </div>

  <h2 class="heading section-heading--spaced">Ingredientes</h2>

  <div data-controller="nested-form">
    <div data-nested-form-target="container">
      <%= f.fields_for :recipe_ingredients do |ri| %>
        <%= render "recipes/ingredient_fields", f: ri %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :recipe_ingredients, RecipeIngredient.new, child_index: "NEW_RECORD" do |ri| %>
        <%= render "recipes/ingredient_fields", f: ri %>
      <% end %>
    </template>

    <button type="button" class="btn btn--ghost btn--sm" data-action="nested-form#add">Agregar ingrediente</button>
  </div>

  <div class="form-actions">
    <%= f.submit @recipe.persisted? ? "Guardar cambios" : "Crear receta", class: "btn" %>
    <%= link_to "Cancelar", @recipe.persisted? ? @recipe : recipes_path, class: "btn btn--ghost" %>
  </div>
<% end %>
