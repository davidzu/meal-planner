<% content_for :title, @recipe.name %>

<div class="week-toolbar">
  <%= link_to "← Recetario", recipes_path, class: "btn btn--ghost btn--sm" %>
  <div style="display: flex; gap: var(--space-3);">
    <%= link_to "Editar", edit_recipe_path(@recipe), class: "btn btn--ghost btn--sm" %>
    <%= button_to "Eliminar", @recipe, method: :delete, class: "btn btn--danger btn--sm", form: {onsubmit: "return confirm('¿Eliminar esta receta?');"} %>
  </div>
</div>

<div class="card" style="max-width: 760px;">
  <h1 class="display" style="margin-bottom: var(--space-2);"><%= @recipe.name %></h1>

  <div class="recipe-card__meta caption" style="margin-bottom: var(--space-4);">
    <span>⏱ <%= @recipe.total_time_label %></span>
    <span>🍽 <%= @recipe.base_servings %> porc.</span>
    <% if @recipe.calories_per_serving.present? %>
      <span>🔥 <%= @recipe.calories_per_serving %> kcal/porc.</span>
    <% end %>
    <% if @recipe.author.present? %>
      <span>👩‍🍳 <%= @recipe.author.email %></span>
    <% end %>
  </div>

  <% if @recipe.tags.any? %>
    <div class="recipe-card__meta" style="margin-bottom: var(--space-4);">
      <% @recipe.tags.each do |tag| %>
        <span class="chip"><%= tag.name %></span>
      <% end %>
    </div>
  <% end %>

  <% if @recipe.description.present? %>
    <p style="margin: 0 0 var(--space-4);"><%= @recipe.description %></p>
  <% end %>

  <h2 class="heading" style="margin-bottom: var(--space-3);">Ingredientes</h2>
  <% if @recipe.recipe_ingredients.any? %>
    <ul style="margin: 0 0 var(--space-5); padding-left: var(--space-5);">
      <% @recipe.recipe_ingredients.each do |ri| %>
        <li style="margin-bottom: var(--space-1);">
          <%= ri.quantity.to_f == ri.quantity.to_i ? ri.quantity.to_i : ri.quantity %> <%= ri.unit %> de <%= ri.ingredient.name %>
          <% if ri.prep_note.present? %>
            <em class="caption">(<%= ri.prep_note %>)</em>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="caption" style="margin-bottom: var(--space-4);">Sin ingredientes registrados.</p>
  <% end %>

  <h2 class="heading" style="margin-bottom: var(--space-3);">Instrucciones</h2>
  <% if @recipe.instructions.present? %>
    <div style="white-space: pre-wrap; margin-bottom: var(--space-5);"><%= @recipe.instructions %></div>
  <% else %>
    <p class="caption" style="margin-bottom: var(--space-5);">Sin instrucciones.</p>
  <% end %>
</div>