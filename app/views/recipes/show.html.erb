<% content_for :title, @recipe.name %>

<div class="week-toolbar">
  <%= link_to "← Recetario", recipes_path, class: "btn btn--ghost btn--sm" %>
  <div class="flex-actions">
    <%= link_to "Editar", edit_recipe_path(@recipe), class: "btn btn--ghost btn--sm" %>
    <%= button_to "Eliminar", @recipe, method: :delete, class: "btn btn--danger btn--sm", form: { data: { turbo_confirm: "¿Eliminar esta receta?" } } %>
  </div>
</div>

<%= render "recipes/card_full", recipe: @recipe %>
