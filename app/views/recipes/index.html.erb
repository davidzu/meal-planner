<% content_for :title, "Recetas" %>

<div class="week-toolbar">
  <h1 class="display">Recetario</h1>
  <%= link_to "Nueva receta", new_recipe_path, class: "btn" %>
</div>

<%= render "shared/search_bar", tags: @tags %>

<% if @recipes.any? %>
  <div class="recipe-grid">
    <% @recipes.each do |recipe| %>
      <div class="card recipe-card">
        <%= link_to recipe, class: "recipe-card__title recipe-card__title-link" do %>
          <%= recipe.name %>
        <% end %>
        <p class="recipe-card__summary"><%= truncate(recipe.description.to_s, length: 90) %></p>
        <div class="recipe-card__meta caption">
          <span>⏱ <%= recipe.total_time_label %></span>
          <span>🍽 <%= recipe.base_servings %> porc.</span>
          <% if recipe.calories_per_serving.present? %>
            <span>🔥 <%= recipe.calories_per_serving %> kcal</span>
          <% end %>
        </div>
        <% if recipe.tags.any? %>
          <div class="recipe-card__meta">
            <% recipe.tags.each do |tag| %>
              <span class="chip"><%= tag.label %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <% filtered = params[:q].present? || params[:tag_id].present? || params[:max_time].present? %>
  <%= render "shared/empty_state",
        icon: "📖",
        message: "No hay recetas que coincidan.",
        cta: (filtered ? link_to("Limpiar búsqueda", recipes_path, class: "btn") : link_to("Crear la primera receta", new_recipe_path, class: "btn")) %>
<% end %>
