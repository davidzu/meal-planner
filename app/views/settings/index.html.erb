<% content_for :title, "Ajustes" %>

<h1 class="display">Ajustes</h1>

<div class="settings-grid">
  <div>
    <h2 class="heading section-heading">Hogar</h2>
    <div class="card">
      <%= form_with model: @household, url: household_path(@household), method: :patch do |f| %>
        <div class="field">
          <%= f.label :name, "Nombre del hogar" %>
          <%= f.text_field :name, required: true %>
        </div>
        <%= f.submit "Guardar", class: "btn btn--sm" %>
      <% end %>
    </div>
    <p class="settings-note">Tipos de comida: Desayuno, Comida, Cena</p>
  </div>

  <div>
    <div class="week-toolbar members-header">
      <h2 class="heading">Miembros</h2>
      <%= link_to "Agregar miembro", new_user_path, class: "btn btn--sm" %>
    </div>

    <% if @members.any? %>
      <% @members.each do |member| %>
        <div class="member-row">
          <div>
            <div><%= member.email %></div>
            <div class="member-row__role"><%= member.role.present? ? member.role.capitalize : "Sin rol" %></div>
          </div>
          <div class="flex-actions">
            <%= link_to "Editar", edit_user_path(member), class: "btn btn--ghost btn--sm" %>
            <%= button_to "Eliminar", member, method: :delete, class: "btn btn--danger btn--sm", form: { data: { turbo_confirm: "¿Eliminar este miembro?" } } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="caption">Sin miembros aún. Agrega a la persona que cocina y a quien planifica.</p>
    <% end %>
  </div>
</div>
