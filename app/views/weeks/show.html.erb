<% content_for :title, @week.label %>

<div class="week-toolbar">
  <div class="week-toolbar__nav">
    <%= link_to "‹", root_path(date: @previous_start_date), class: "btn btn--ghost btn--sm", aria: { label: "Semana anterior" } %>
    <h1 class="display"><%= @week.label %></h1>
    <%= link_to "›", root_path(date: @next_start_date), class: "btn btn--ghost btn--sm", aria: { label: "Siguiente semana" } %>
  </div>

  <div class="week-toolbar__actions">
    <%= form_with model: @week, url: week_path(@week), method: :patch, class: "people-form" do |f| %>
      <%= f.label :people_count, "Personas" %>
      <%= f.number_field :people_count, min: 1 %>
      <%= f.submit "OK", class: "btn btn--ghost btn--sm" %>
    <% end %>

    <%= button_to "Generar lista de compras", shopping_list_week_path(@week), method: :post, class: "btn", disabled: @week.filled_slot_count.zero? %>

    <% if @previous_week %>
      <%= button_to "Copiar semana anterior", copy_week_path(@week), method: :post, params: { source_week_id: @previous_week.id }, class: "btn btn--ghost" %>
    <% end %>

    <% if @week.filled_slot_count.positive? %>
      <%= button_to "Vaciar semana", clear_week_path(@week), method: :post, class: "btn btn--danger", data: { turbo_confirm: "¿Vaciar todos los platillos de esta semana?" } %>
    <% end %>
  </div>
</div>

<% if @week.filled_slot_count.zero? %>
  <%= render "shared/empty_state",
        message: "Empieza por el lunes",
        cta: (@previous_week ? button_to("Copiar semana anterior", copy_week_path(@week), method: :post, params: { source_week_id: @previous_week.id }, class: "btn btn--ghost") : nil) %>
<% end %>

<%= render "weeks/week_grid", week: @week %>
